{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminarylabs-dev.github.io/Frameulator/schemas/protocol.schema.json",
  "title": "Frameulator Worker RPC message",
  "oneOf": [
    {
      "type": "object",
      "required": ["protocol", "requestId", "method"],
      "properties": {
        "protocol": { "const": "frameulator/1" },
        "requestId": { "type": "integer", "minimum": 1 },
        "method": { "type": "string", "minLength": 1 },
        "parameters": {}
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["protocol", "requestId", "ok"],
      "properties": {
        "protocol": { "const": "frameulator/1" },
        "requestId": { "type": "integer", "minimum": 1 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": { "type": "string" }
      },
      "additionalProperties": false
    }
  ]
}


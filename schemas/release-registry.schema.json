{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminarylabs-dev.github.io/Frameulator/schemas/release-registry.schema.json",
  "title": "Signed Agora browser release registry",
  "type": "object",
  "required": ["schemaVersion", "algorithm", "keyId", "payload", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 },
    "payload": {
      "type": "object",
      "required": ["releases"],
      "properties": {
        "releases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["appId", "version", "sourceCommit", "architecture", "flatpakFile", "flatpakSha256", "browserWasmFile", "browserWasmSha256", "executionMode"],
            "properties": {
              "appId": { "const": "dev.luminarylabs.Agora" },
              "version": { "pattern": "^0\\.0\\.[0-9]+$" },
              "sourceCommit": { "pattern": "^[0-9a-f]{40}$" },
              "architecture": { "enum": ["x86_64", "aarch64"] },
              "flatpakFile": { "pattern": "\\.flatpak$" },
              "flatpakSha256": { "pattern": "^[0-9a-f]{64}$" },
              "browserWasmFile": { "pattern": "\\.wasm$" },
              "browserWasmSha256": { "pattern": "^[0-9a-f]{64}$" },
              "executionMode": { "const": "browser-wasm-capsule" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

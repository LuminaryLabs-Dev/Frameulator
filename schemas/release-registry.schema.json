{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminarylabs-dev.github.io/Frameulator/schemas/release-registry.schema.json",
  "title": "Signed application browser release registry",
  "description": "Signature covers UTF-8 JSON.stringify(payload), preserving property order. Every package SHA-256 must be unique. Runtime verification additionally enforces trust, URL policy, canonical base64, and a 1 MiB payload limit.",
  "type": "object",
  "required": [
    "schemaVersion",
    "algorithm",
    "keyId",
    "payload",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "signature": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "payload": {
      "type": "object",
      "required": [
        "releases"
      ],
      "properties": {
        "releases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {
            "type": "object",
            "required": [
              "appId",
              "version",
              "sourceCommit",
              "adapterId",
              "adapterVersion",
              "packageFile",
              "packageSha256",
              "artifactFile",
              "artifactSha256",
              "executionMode",
              "capsuleAbi"
            ],
            "properties": {
              "appId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "version": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "sourceCommit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "adapterId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "adapterVersion": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
              },
              "packageFile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f\\\\]).*\\S$"
              },
              "packageSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "artifactFile": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048,
                "pattern": "^(?!\\s)(?!.*[\\u0000-\\u001f\\u007f\\\\]).*\\S$",
                "description": "HTTP(S) URL without embedded credentials, or a relative URL resolved against the registry URL. Other URL schemes are rejected at runtime."
              },
              "artifactSha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "executionMode": {
                "const": "browser-wasm-capsule"
              },
              "capsuleAbi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

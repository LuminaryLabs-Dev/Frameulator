{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frameulator generic simulation report",
  "type": "object",
  "required": [
    "schemaVersion",
    "frameulatorVersion",
    "scenario",
    "profile",
    "simulated",
    "evidenceLevel",
    "passed",
    "generatedAt",
    "hostKernelExecuted",
    "applicationExecuted",
    "applicationAssertionsChecked",
    "nativeExecutionProven",
    "hardwareProven",
    "events"
  ],
  "properties": {
    "schemaVersion": { "const": 3 },
    "frameulatorVersion": { "const": "0.3.0" },
    "scenario": { "type": "string" },
    "profile": { "type": "string" },
    "simulated": { "const": true },
    "evidenceLevel": { "const": "F1-browser-wasm" },
    "passed": { "type": "boolean" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hostKernelExecuted": { "const": true },
    "applicationExecuted": { "type": "boolean" },
    "applicationAssertionsChecked": { "const": false },
    "nativeExecutionProven": { "const": false },
    "hardwareProven": { "const": false },
    "events": { "type": "array", "maxItems": 256 },
    "application": {
      "type": "object",
      "required": [
        "appId",
        "version",
        "adapterId",
        "adapterVersion",
        "source",
        "executionMode",
        "trust",
        "signatureVerified",
        "state",
        "data",
        "surfaces"
      ],
      "properties": {
        "appId": { "type": "string" },
        "version": { "type": "string" },
        "adapterId": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "source": { "type": "object" },
        "executionMode": { "const": "trusted-js-adapter" },
        "trust": { "const": "host-injected" },
        "signatureVerified": { "const": false },
        "surfaces": { "type": "array", "maxItems": 4 }
      }
    }
  }
}

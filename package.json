{
  "name": "frameulator-workspace",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:package": "node scripts/build-package.mjs",
    "build:site": "vite build --config apps/web/vite.config.ts",
    "build": "npm run clean && npm run build:wasm && npm run build:package && npm run build:site",
    "check": "tsc -p packages/frameulator/tsconfig.build.json --noEmit",
    "test": "node --test packages/frameulator/tests/*.test.mjs",
    "verify": "npm run build && npm run check && npm test && node scripts/verify-release.mjs",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "pack:check": "npm pack --dry-run --workspace @luminarylabs/frameulator"
  },
  "devDependencies": {
    "@types/three": "0.179.0",
    "esbuild": "0.25.9",
    "three": "0.179.1",
    "typescript": "5.9.2",
    "vite": "7.1.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.9.0"
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luminarylabs-dev.github.io/Frameulator/schemas/site-release-config.schema.json",
  "title": "Frameulator static-site release configuration",
  "type": "object",
  "required": ["schemaVersion", "enabled", "releaseRegistry", "trustedReleaseKey"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "enabled": { "type": "boolean" },
    "releaseRegistry": { "type": ["string", "null"] },
    "trustedReleaseKey": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id", "algorithm", "publicKeyBase64"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "algorithm": { "const": "Ed25519" },
            "publicKeyBase64": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "enabled": { "const": true } } },
      "then": {
        "properties": {
          "releaseRegistry": { "type": "string", "minLength": 1 },
          "trustedReleaseKey": { "type": "object" }
        }
      }
    }
  ],
  "additionalProperties": false
}
